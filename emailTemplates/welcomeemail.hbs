<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Email Template</title>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap");
      * {
        font-family: "Nunito", serif;
        font-style: normal;
      }
      /* General Reset */
      body,
      html {
        margin: 0;
        padding: 0;
        font-family: Arial, sans-serif;
        font-size: 16px;
        line-height: 1.6;
        color: #333;
      }

      /* Email Wrapper */
      .email-wrapper {
        max-width: 600px;
        margin: 0 auto;
        background-color: #f9f9f9;
        border: 2px solid #3e3e3e;
      }

      /* Header */
      .header {
        background-color: #3e3e3e;
        color: #ffffff;
        padding: 10px 20px;
        text-align: center;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 95px;
      }

      /* Content Body */
      .content {
        background-color: #ffffff;
        padding: 20px;
        font-size: 25px;
      }

      /* Receipt Box */
      .receipt {
        border: 2px solid #4caf50;
        background-color: #e8f5e9;
        color: #2e7d32;
        padding: 15px;
        margin-top: 20px;
        font-size: 18px;
        border-radius: 5px;
        text-transform: uppercase;
      }

      /* Footer */
      .footer {
        padding: 10px 20px;
        text-align: center;
      }
    </style>
  </head>

  <body>
    <div class="email-wrapper">
      <!-- Header -->
      <div class="header">
        <h1 style="margin-top: 0%; font-weight: lighter; font-size: 25px; font-weight: 700; letter-spacing: 5px;">
          Model National Assembly
        </h1>
      </div>

      <!-- Content -->
      <div class="content">
        <p>Hi {{Name}},</p>
        <p>Welcome to Model National Assembly 2025 #MNA25</p>
        <p>Here is your registration number <strong>{{regNo}}</strong>.</p>

        <!-- Payment Receipt -->
        <div class="receipt">
          <p><strong>Payment Receipt</strong></p>
          <p>Amount Paid: <strong>₦{{amount}}</strong></p>
          <p>Transaction Reference: <strong>{{ref}}</strong></p>
        </div>

        <p>
          If you need any assistance, feel free to contact us at
          <a href="">blacksmileconcepts@gmail.com</a>.
        </p>
        <p>Thank you for your participation!</p>
      </div>

      <!-- Footer -->
      <div class="footer">
        <p
          style="
            background-color: #dad7d7;
            padding: 2px;
            margin: 0px 5px;
            font-size: large;
            color: black;
          "
        >
          &#169; 2025 Model National Assembly
        </p>
      </div>
    </div>
  </body>
</html>